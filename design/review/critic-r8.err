    10	type Form = { asset: number; buy: boolean; sz: string; px: string; ro: boolean }
    11	type Check = { k: string; v: string; ok: boolean | null }
    12	
    13	export function Ticket({ s, vault, abi, onSent }: { s: Vault; vault: Address; abi: any; onSent: (r: WriteResult) => void }) {
    14	  const ethPx = pxOf(s.pos.find((p) => p.m === 4) ?? { m: 4, px: 248000, szi: 0 })
    15	  const capUsd = s.cap / 1e6 || 20
    16	  const [f, setF] = useState<Form>({ asset: 4, buy: true, sz: (2.5 * capUsd / ethPx).toFixed(4), px: '', ro: false })
    17	  const [checks, setChecks] = useState<Check[] | null>(null)
    18	  const [verdict, setVerdict] = useState<{ ok: boolean; text: string } | null>(null)
    19	  const [out, setOut] = useState<WriteResult | null>(null)
    20	  const [busy, setBusy] = useState(false)
    21	
    22	  const args = async (): Promise<[number, boolean, bigint, bigint, boolean]> => {
    23	    const d = SZD[f.asset] ?? 2
    24	    let px = Number(f.px)
    25	    if (!px) {
    26	      const p = s.pos.find((q) => q.m === f.asset)
    27	      const o = p ? null : await pub.readContract({ address: vault, abi, functionName: 'oraclePx', args: [f.asset] }).catch(() => null)
    28	      if (!p && o == null) throw new Error('PRICE')
    29	      const raw = p ? pxOf(p) : Number(o) / 10 ** (6 - d)
    30	      px = Math.round(raw * (f.buy ? 1.02 : 0.98))
    31	    }
    32	    return [f.asset, f.buy, BigInt(Math.round(px * 1e8)), BigInt(Math.round(Number(f.sz || 0) * 1e8)), f.ro]
    33	  }
    34	
    35	  useEffect(() => {
    36	    let live = true
    37	    setChecks(null); setVerdict(null)
    38	    const t = setTimeout(async () => {
    39	      const slow = setTimeout(() => { if (live) { setChecks([]); setVerdict({ ok: false, text: 'The testnet RPC did not answer within 8 s. Edit the order to check again.' }) } }, 8000)
    40	      let a: Awaited<ReturnType<typeof args>>
    41	      try { a = await args() } catch { clearTimeout(slow); if (live) { setChecks([]); setVerdict({ ok: false, text: `No oracle price for ${MK[f.asset]} right now (it may not be listed on this vault), so the order did not reach the contract check. Enter a limit price to check it.` }) } return }
    42	      const [asset, buy, , sz8, ro] = a
    43	      const allowed = s.markets.includes(asset)
    44	      let lev: number | null = null
    45	      if (allowed) { try { lev = Number(await pub.readContract({ address: vault, abi, functionName: 'notionalAfter', args: [asset, buy, sz8] })) / s.cap } catch { lev = null } }
    46	      const levOk = lev == null ? (allowed ? null : false) : lev <= s.maxLev || ro
    47	      const room = (s.eq - s.floor) / 1e6
    48	      const c: Check[] = [
    49	        { k: 'Market', v: `${MK[asset] ?? asset} ${allowed ? 'is allowed' : 'is not on the list'}`, ok: allowed },
    50	        { k: 'Leverage', v: lev == null ? (allowed ? 'RPC busy, retrying' : 'not checked') : `${lev.toFixed(2)}x after fill, cap ${s.maxLev}x`, ok: levOk },
    51	        { k: 'Loss line', v: `${room.toFixed(2)} USDC of room`, ok: room >= 0 },
    52	        { k: 'Frozen', v: s.breached ? 'yes, flattened' : 'no', ok: !s.breached },
    53	      ]
    54	      let v: { ok: boolean; text: string }
    55	      try { await pub.simulateContract({ account: s.trader as Address, address: vault, abi, functionName: 'trade', args: a }); v = { ok: true, text: 'The contract accepts this order (simulated as the trader).' } }
    56	      catch (e: any) { v = rpcLimited(e) ? { ok: false, text: 'The testnet RPC is rate limiting reads. The check reruns when you edit the order.' } : { ok: false, text: 'The contract refuses it: ' + String(e.shortMessage || e.message).split('\n').pop()!.replace(/^.*reverted with the following reason:\s*/, '') } }
    57	      clearTimeout(slow)
    58	      if (live) { setChecks(c); setVerdict(v) }
    59	    }, 250)
    60	    return () => { live = false; clearTimeout(t) }
    61	    // eslint-disable-next-line react-hooks/exhaustive-deps
    62	  }, [f, s, vault])
    63	
    64	  const unavailable = verdict != null && /rate limiting|did not answer|No oracle price/.test(verdict.text)
    65	  const phase: 'checking' | 'ok' | 'no' | 'unknown' = !verdict ? 'checking' : verdict.ok ? 'ok' : unavailable ? 'unknown' : 'no'
    66	  const preset = (k: string) => {
    67	    const P: Record<string, Form> = {
    68	      ok: { asset: 4, buy: true, sz: (2.5 * capUsd / ethPx).toFixed(4), px: '', ro: false },
    69	      lev: { asset: 4, buy: true, sz: (20 * capUsd / ethPx).toFixed(4), px: '', ro: false },
    70	      fake: { asset: 4, buy: true, sz: (5 * capUsd / ethPx).toFixed(4), px: '1', ro: false },
    71	      sol: { asset: 5, buy: true, sz: '0.10', px: '150', ro: false },
    72	    }
    73	    setF(P[k]); setOut(null)
    74	  }
    75	  const send = async () => { setBusy(true); const r = await write(vault, abi, 'trade', await args()); setOut(r); onSent(r); setBusy(false) }
    76	  const sign = async () => {
    77	    setBusy(true)
    78	    try {
    79	      const [asset, isBuy, limitPx8, sz8, reduceOnly] = await args()
    80	      const g = await signOrder(vault, { asset, isBuy, limitPx8, sz8, reduceOnly })
    81	      const r = await write(vault, abi, 'tradeBySig', [g.order, g.v, g.r, g.s]); setOut(r); onSent(r)
    82	    } catch (e: any) { setOut({ ok: false, text: String(e.shortMessage || e.message) }) }
    83	    setBusy(false)
    84	  }
    85	
    86	  return (
    87	    <form className="ticket" onSubmit={(e) => { e.preventDefault(); send() }}>
    88	      <div className="presets" aria-label="Try an order">
    89	        <span className="text-dim">Try</span>
    90	        <button type="button" onClick={() => preset('ok')}>2.5x long</button>
    91	        <button type="button" onClick={() => preset('lev')}>20x long</button>
    92	        <button type="button" onClick={() => preset('fake')}>$1 limit</button>
    93	        <button type="button" onClick={() => preset('sol')}>SOL</button>
    94	      </div>
    95	      <div className="fields">
    96	        <div className="field">
    97	          <Label htmlFor="asset">Market</Label>
    98	          <select id="asset" className="select" value={f.asset} onChange={(e) => setF({ ...f, asset: Number(e.target.value) })}>
    99	            <option value={4}>ETH</option><option value={3}>BTC</option><option value={5}>SOL</option>
   100	          </select>
   101	        </div>
   102	        <fieldset className="field">
   103	          <legend className="lbl-legend">Side</legend>
   104	          <div className="seg" role="radiogroup">
   105	            <button type="button" role="radio" aria-checked={f.buy} onClick={() => setF({ ...f, buy: true })}>Long</button>
   106	            <button type="button" role="radio" aria-checked={!f.buy} onClick={() => setF({ ...f, buy: false })}>Short</button>
   107	          </div>
   108	        </fieldset>
   109	        <div className="field">
   110	          <Label htmlFor="sz">Size <span className="text-dim">{MK[f.asset]}</span></Label>
   111	          <Input id="sz" inputMode="decimal" value={f.sz} onChange={(e) => setF({ ...f, sz: e.target.value })} />
   112	        </div>
   113	        <div className="field">
   114	          <Label htmlFor="px">Limit price <span className="text-dim">USD</span></Label>
   115	          <Input id="px" inputMode="decimal" placeholder="oracle ±2%" value={f.px} onChange={(e) => setF({ ...f, px: e.target.value })} />
   116	        </div>
   117	      </div>
   118	      <label className="check"><input type="checkbox" checked={f.ro} onChange={(e) => setF({ ...f, ro: e.target.checked })} /> Reduce only</label>
   119	
   120	      <table className="checks" aria-live="polite">
   121	        <tbody>
   122	          {checks && checks.length ? checks.map((c) => (
   123	            <tr key={c.k}><th scope="row">{c.k}</th><td>{c.v}</td><td className={c.ok === null ? 'wait' : c.ok ? 'pass' : 'fail'}>{c.ok === null ? 'wait' : c.ok ? 'pass' : 'fail'}</td></tr>
   124	          )) : checks ? <tr><td colSpan={3} className="text-dim">No answer from the contract.</td></tr> : <tr><td colSpan={3} className="text-dim">Asking the contract&hellip;</td></tr>}
   125	        </tbody>
   126	      </table>
   127	      {verdict && <p className={verdict.ok ? 'verdict' : 'verdict verdict-no'}>{verdict.text}</p>}
   128	      {f.asset === 4 && Number(f.sz) > 0 && <p className="verdict text-dim">Notional about {(Number(f.sz) * (Number(f.px) || ethPx)).toFixed(2)} USD against {capUsd.toFixed(2)} USDC capital. The signature path lets any relayer submit; here your wallet submits it.</p>}
   129	
   130	      <div className="actions">
   131	        <Button type="submit" disabled={busy || phase === 'checking'}>{busy ? 'Waiting for the wallet\u2026' : phase === 'checking' ? 'Checking\u2026' : phase === 'ok' ? 'Send order' : phase === 'no' ? 'Send anyway, it will revert' : 'Send unchecked'}</Button>
   132	        <Button type="button" variant="outline" disabled={busy || phase === 'checking'} onClick={sign}>Sign, then submit (you pay gas)</Button>
   133	      </div>
   134	      {out && <p className={out.ok ? 'verdict' : 'verdict verdict-no'}>{out.text} {out.tx && <Tx hash={out.tx} />}</p>}
   135	    </form>
   136	  )
   137	}
     1	@import "tailwindcss";
     2	
     3	/* BACKED tokens (docs/design/DESIGN.md). Paper 70 / ink 20 / vermilion 10, one radius, 8px space scale. */
     4	:root {
     5	  --paper: #14120f;
     6	  --raised: #1b1814;
     7	  --line: #2c2821;
     8	  --ink: #ece5d8;
     9	  --dim: #a39a8b;
    10	  --alarm: #ff5b35;
    11	  --r: 4px;
    12	
    13	  /* shadcn variables mapped onto the tokens */
    14	  --background: var(--paper);
    15	  --foreground: var(--ink);
    16	  --card: var(--raised);
    17	  --card-foreground: var(--ink);
    18	  --popover: var(--raised);
    19	  --popover-foreground: var(--ink);
    20	  --primary: var(--ink);
    21	  --primary-foreground: var(--paper);
    22	  --secondary: var(--raised);
    23	  --secondary-foreground: var(--ink);
    24	  --muted: var(--raised);
    25	  --muted-foreground: var(--dim);
    26	  --accent: var(--raised);
    27	  --accent-foreground: var(--ink);
    28	  --destructive: var(--alarm);
    29	  --border: var(--line);
    30	  --input: var(--line);
    31	  --ring: var(--ink);
    32	  --radius: var(--r);
    33	}
    34	
    35	@theme inline {
    36	  --font-sans: "Public Sans", ui-sans-serif, sans-serif;
    37	  --font-display: "Familjen Grotesk", "Public Sans", sans-serif;
    38	  --color-background: var(--background);
    39	  --color-foreground: var(--foreground);
    40	  --color-card: var(--card);
    41	  --color-card-foreground: var(--card-foreground);
    42	  --color-popover: var(--popover);
    43	  --color-popover-foreground: var(--popover-foreground);
    44	  --color-primary: var(--primary);
    45	  --color-primary-foreground: var(--primary-foreground);
    46	  --color-secondary: var(--secondary);
    47	  --color-secondary-foreground: var(--secondary-foreground);
    48	  --color-muted: var(--muted);
    49	  --color-muted-foreground: var(--muted-foreground);
    50	  --color-accent: var(--accent);
    51	  --color-accent-foreground: var(--accent-foreground);
    52	  --color-destructive: var(--destructive);
    53	  --color-border: var(--border);
    54	  --color-input: var(--input);
    55	  --color-ring: var(--ring);
    56	  --color-dim: var(--dim);
    57	  --color-alarm: var(--alarm);
    58	  --radius-sm: var(--r);
    59	  --radius-md: var(--r);
    60	  --radius-lg: var(--r);
    61	  --radius-xl: var(--r);
    62	}
    63	
    64	* { border-color: var(--line); }
    65	html { background: var(--paper); color-scheme: dark; }
    66	body { margin: 0; background: var(--paper); color: var(--ink); font: 400 16px/1.5 var(--font-sans); font-variant-numeric: tabular-nums; -webkit-font-smoothing: antialiased; }
    67	a { color: inherit; text-decoration: underline; text-decoration-color: var(--dim); text-underline-offset: 3px; }
    68	a:hover { text-decoration-color: var(--ink); }
    69	:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; border-radius: var(--r); }
    70	.text-dim { color: var(--dim); }
    71	.num { font-variant-numeric: tabular-nums; }
    72	
    73	/* masthead: one line */
    74	.mast { border-bottom: 1px solid var(--line); padding-top: env(safe-area-inset-top); }
    75	::selection { background: var(--ink); color: var(--paper); }
    76	html { caret-color: var(--ink); scrollbar-color: var(--line) var(--paper); }
    77	button, select, [role="tab"], [role="radio"] { cursor: pointer; }
    78	button:disabled { cursor: not-allowed; opacity: 0.55; }
    79	.ticket input, .backer input { height: 40px; }
    80	.actions button { min-height: 40px; }
    81	.mast-in { max-width: 1240px; margin: 0 auto; padding: 12px 32px; display: flex; align-items: center; gap: 16px; }
    82	.word { font: 600 18px/1 var(--font-display); letter-spacing: -0.02em; }
    83	.mast-meta { font-size: 13px; margin-right: auto; }
    84	
    85	.page { max-width: 1240px; margin: 0 auto; padding: 48px 32px 64px; }
    86	.fold { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 64px; align-items: start; }
    87	.kicker { margin: 0 0 12px; font-size: 13px; color: var(--dim); }
    88	h1 { margin: 0; font: 600 40px/1.1 var(--font-display); letter-spacing: -0.03em; max-width: 18ch; text-wrap: balance; }
    89	.lede { margin: 16px 0 32px; max-width: 56ch; color: var(--dim); font-size: 16px; }
    90	h2 { margin: 0; font: 600 24px/1.15 var(--font-display); letter-spacing: -0.02em; }
    91	.h3 { margin: 0 0 12px; font: 600 18px/1.2 var(--font-display); letter-spacing: -0.01em; }
    92	
    93	/* status sentence (drift's pause banner, flighty's delta-first rows) */
    94	.status { min-height: 56px; }
    95	.state-line { margin: 0; font: 600 24px/1.25 var(--font-display); letter-spacing: -0.02em; }
    96	.state-line.alarm { color: var(--alarm); }
    97	.state-sub { display: block; margin-top: 4px; font: 400 16px/1.5 var(--font-sans); letter-spacing: 0; color: var(--dim); }
    98	
    99	/* signature: the loss-line ruler */
   100	.ruler { margin: 24px 0 8px; padding: 40px 12px 0; overflow-x: clip; }
   101	.ruler-track { position: relative; height: 48px; border: 1px solid var(--line); border-radius: var(--r); background: var(--raised); }
   102	.ruler-dead { position: absolute; inset: 0 auto 0 0; background: rgb(255 91 53 / 0.1); border-right: 0; }
   103	.ruler-line { position: absolute; top: -12px; bottom: -12px; width: 2px; margin-left: -1px; background: var(--alarm); }
   104	.ruler-line-label { position: absolute; bottom: 100%; left: 0; transform: translateX(-50%); padding-bottom: 4px; white-space: nowrap; font-size: 13px; color: var(--alarm); }
   105	.ruler-zero { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--dim); opacity: 0.5; }
   106	.ruler-eq-slide { position: absolute; inset: 0; pointer-events: none; transition: transform 420ms cubic-bezier(0.2, 0.7, 0.2, 1); }
   107	.ruler-eq { position: absolute; left: 0; top: 8px; bottom: 8px; width: 4px; margin-left: -2px; background: var(--ink); border-radius: var(--r); }
   108	.ruler-eq-label { position: absolute; top: calc(100% + 12px); left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 13px; font-weight: 500; }
   109	.ruler-ticks { position: relative; height: 40px; margin-top: 28px; }
   110	.ruler-ticks span { position: absolute; top: 0; transform: translateX(-50%); font-size: 12px; color: var(--dim); }
   111	.ruler-ticks span::before { content: ""; position: absolute; top: -10px; left: 50%; width: 1px; height: 6px; background: var(--line); }
   112	.ruler-ticks span.major::before { height: 8px; background: var(--dim); }
   113	.ruler-below .ruler-eq { background: var(--alarm); }
   114	.ruler-below .ruler-eq-label { color: var(--alarm); }
   115	.ruler-flash-layer { position: absolute; inset: -1px; border: 1px solid var(--alarm); border-radius: var(--r); opacity: 0; pointer-events: none; }
   116	.ruler-flash .ruler-flash-layer { animation: flash 420ms ease-out 1; }
   117	@keyframes flash { 0% { opacity: 1; } 100% { opacity: 0; } }
   118	.hint { margin: 0; font-size: 14px; }
   119	.measured { display: block; margin-top: 8px; color: var(--ink); }
   120	.tabs [role="tab"] { min-height: 44px; }
   121	.check { min-height: 44px; }
   122	.hint .linkish { padding: 12px 0; margin: -12px 0; display: inline-block; }
   123	.linkish { background: none; border: 0; padding: 0; color: var(--ink); font: inherit; text-decoration: underline; text-decoration-color: var(--dim); text-underline-offset: 3px; cursor: pointer; }
   124	.linkish:disabled { color: var(--dim); cursor: default; }
   125	
   126	/* desk: ticket + backer */
   127	.desk { border: 1px solid var(--line); border-radius: var(--r); background: var(--raised); padding: 16px 24px 24px; }
   128	.tabs { background: transparent; padding: 0; gap: 24px; height: auto; border-bottom: 1px solid var(--line); width: 100%; justify-content: flex-start; border-radius: 0; margin-bottom: 16px; }
   129	.tabs [role="tab"] { flex: none; padding: 8px 0; border: 0; border-bottom: 2px solid transparent; border-radius: 0; background: transparent; box-shadow: none; color: var(--dim); font: 500 15px/1 var(--font-sans); }
   130	.tabs [role="tab"][data-state="active"] { color: var(--ink); border-bottom-color: var(--ink); background: transparent; box-shadow: none; }
   131	.presets { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 16px; font-size: 13px; }
   132	.presets button { min-height: 32px; border: 1px solid var(--line); border-radius: var(--r); background: transparent; color: var(--ink); padding: 4px 12px; font: inherit; cursor: pointer; transition: border-color 150ms ease-out; }
   133	.presets button:hover { border-color: var(--dim); }
   134	.fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; margin-bottom: 12px; }
   135	.field { display: grid; gap: 4px; border: 0; padding: 0; margin: 0; min-width: 0; }
   136	.field label, .lbl-legend { font-size: 13px; font-weight: 500; color: var(--dim); padding: 0; }
   137	.select { height: 40px; border: 1px solid var(--line); border-radius: var(--r); background: var(--paper); color: var(--ink); padding: 0 8px; font: inherit; }
   138	.seg { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; height: 40px; }
   139	.seg button { border: 0; background: var(--paper); color: var(--dim); font: inherit; cursor: pointer; }
   140	.seg button[aria-checked="true"] { background: var(--ink); color: var(--paper); font-weight: 500; }
   141	.check { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--dim); margin-bottom: 16px; }
   142	.check input { accent-color: var(--ink); width: 16px; height: 16px; }
   143	.checks { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 12px; }
   144	.checks th, .checks td { text-align: left; padding: 8px 0; border-top: 1px solid var(--line); font-weight: 400; }
   145	.checks th { color: var(--dim); width: 6.5rem; }
   146	.checks td.pass, .checks td.fail { text-align: right; font-weight: 500; }
   147	.checks td.fail { color: var(--ink); font-weight: 600; text-decoration: underline; text-decoration-color: var(--dim); text-underline-offset: 3px; }
   148	.checks td.wait { color: var(--dim); }
   149	.m-lbl { display: none; }
   150	.verdict { margin: 0 0 12px; font-size: 13px; }
   151	.verdict-no { color: var(--ink); font-weight: 500; }
   152	.actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
   153	.backer section + section { margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--line); }
   154	
   155	/* sections down the page */
   156	.rule { margin: 48px 0 24px; background: var(--line); }
   157	.sec-head { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 32px; align-items: baseline; margin-bottom: 24px; }
   158	.sec-head p { margin: 0; font-size: 16px; max-width: 64ch; }
   159	.sheet { font-size: 14px; }
   160	.sheet th { color: var(--dim); font-weight: 500; font-size: 13px; }
   161	.sheet td { vertical-align: top; padding-top: 12px; padding-bottom: 12px; }
   162	.param { font: 500 13px/1 var(--font-sans); background: var(--raised); border: 1px solid var(--line); border-radius: var(--r); padding: 4px 8px; }
   163	.tx { font-size: 14px; }
   164	.lede-short { display: none; }
   165	
   166	/* incidents (github status rail) */
   167	.incidents { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 32px; align-items: start; }
   168	.inc-sum { position: sticky; top: 24px; font-size: 14px; color: var(--dim); }
   169	.inc-sum dl { margin: 0 0 16px; display: grid; gap: 12px; }
   170	.inc-sum dt { font-size: 13px; }
   171	.inc-sum dd { margin: 0; font: 600 18px/1.3 var(--font-display); color: var(--ink); letter-spacing: -0.02em; }
   172	.inc-sum p { margin: 0 0 12px; max-width: 40ch; }
   173	.month { margin: 0 0 16px; font: 600 18px/1.2 var(--font-display); color: var(--dim); }
   174	.rail { list-style: none; margin: 0; padding: 0 0 0 24px; border-left: 1px solid var(--line); }
   175	.inc { position: relative; padding: 0 0 16px; }
   176	.inc::before { content: ""; position: absolute; left: -29px; top: 6px; width: 9px; height: 9px; border: 1px solid var(--dim); background: var(--paper); border-radius: var(--r); }
   177	.inc-breach::before { border-color: var(--alarm); background: var(--alarm); }
   178	.inc-title { margin: 0; font: 600 18px/1.3 var(--font-display); letter-spacing: -0.01em; }
   179	.inc-breach .inc-title { color: var(--alarm); }
   180	.inc-body { color: var(--ink); }
   181	.inc-when { margin: 4px 0 0; max-width: 64ch; font-size: 14px; color: var(--dim); }
   182	
   183	/* equity chart */
   184	.chart { display: block; max-width: 100%; height: auto; }
   185	.chart .grid line { stroke: var(--line); }
   186	.chart text { fill: var(--dim); font: 400 13px var(--font-sans); }
   187	.chart .zero { stroke: var(--dim); stroke-opacity: 0.6; }
   188	.chart .floor { stroke: var(--alarm); stroke-dasharray: 4 4; }
   189	.chart .step { fill: none; stroke: var(--ink); stroke-width: 1.5; }
   190	.chart .now { fill: var(--ink); }
   191	.chart .lbl-alarm { fill: var(--alarm); }
   192	.chart .lbl-ink { fill: var(--ink); }
   193	.chart-state, .note { font-size: 13px; color: var(--dim); }
   194	.chart-state { padding: 32px 0; }
   195	
   196	.vaults { list-style: none; margin: 0; padding: 0; font-size: 13px; }
   197	.vaults li { display: flex; gap: 16px; padding: 8px 0; border-top: 1px solid var(--line); overflow-wrap: anywhere; }
   198	.foot { border-top: 1px solid var(--line); }
   199	.foot p { max-width: 1240px; margin: 0 auto; padding: 24px 32px calc(32px + env(safe-area-inset-bottom)); font-size: 13px; color: var(--dim); }
   200	
   201	@media (prefers-reduced-motion: no-preference) {
   202	  .lead > * { animation: rise 240ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
   203	  .lead > .status, .lead > .ruler { animation-delay: 60ms; }
   204	}
   205	@keyframes rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
   206	@media (prefers-reduced-motion: reduce) {
   207	  *, *::before, *::after { animation: none !important; transition: none !important; }
   208	}
   209	
   210	@media (max-width: 900px) {
   211	  .fold { grid-template-columns: 1fr; gap: 40px; }
   212	  .sec-head { grid-template-columns: 1fr; gap: 8px; }
   213	  .incidents { grid-template-columns: 1fr; }
   214	  .inc-sum { position: static; }
   215	}
   216	@media (max-width: 560px) {
   217	  .mast-in, .page, .foot p { padding-left: 16px; padding-right: 16px; }
   218	  .page { padding-top: 32px; }
   219	  h1 { font-size: 28px; max-width: none; }
   220	  .lede { display: none; }
   221	  .state-line { font-size: 20px; }
   222	  .measured { display: none; }
   223	  .hint { display: none; }
   224	  .fold { gap: 24px; }
   225	  .ruler { padding-top: 28px; margin: 12px 0 0; }
   226	  .mast-in { flex-wrap: wrap; row-gap: 4px; }
   227	  .word { margin-right: auto; }
   228	  .mast-meta { order: 3; flex-basis: 100%; margin: 0; }
   229	  .fields { grid-template-columns: 1fr; }
   230	  .desk { padding: 12px 16px 16px; }
   231	  input, select { font-size: 16px !important; }
   232	  .ticket input, .backer input, .select, .seg, .actions button, .presets button, .mast button { min-height: 44px; }
   233	  .tabs [role="tab"] { padding: 14px 0; }
   234	  .sheet thead { display: none; }
   235	  .sheet tr { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; padding: 12px 0; }
   236	  .sheet td { display: block; padding: 0 !important; white-space: normal; }
   237	  .sheet td:nth-child(3) { grid-column: 1 / -1; }
   238	  .key-sheet tr { grid-template-columns: 1fr; }
   239	  .key-sheet td:nth-child(2) { grid-column: 1 / -1; }
   240	  .m-lbl { display: inline; color: var(--dim); }
   241	  .sheet td:last-child:not(:nth-child(3)) { text-align: left; }
   242	  .rule { margin: 48px 0 24px; }

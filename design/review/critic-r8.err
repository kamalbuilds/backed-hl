```
`mode: "none"` when the detector did not run.

### Scoring System

**Dual headline scores:**
- **Design Score: {A-F}** — weighted average of all 10 categories
- **AI Slop Score: {A-F}** — standalone grade with pithy verdict

**Per-category grades:**
- **A:** Intentional, polished, delightful. Shows design thinking.
- **B:** Solid fundamentals, minor inconsistencies. Looks professional.
- **C:** Functional but generic. No major problems, no design point of view.
- **D:** Noticeable problems. Feels unfinished or careless.
- **F:** Actively hurting user experience. Needs significant rework.

**Grade computation:** Each category starts at A. Each High-impact finding drops one letter grade. Each Medium-impact finding drops half a letter grade. Polish findings are noted but do not affect grade. Minimum is F.

**Category weights for Design Score:**
| Category | Weight |
|----------|--------|
| Visual Hierarchy | 15% |
| Typography | 15% |
| Spacing & Layout | 15% |
| Color & Contrast | 10% |
| Interaction States | 10% |
| Responsive | 10% |
| Content Quality | 10% |
| AI Slop | 5% |
| Motion | 5% |
| Performance Feel | 5% |

AI Slop is 5% of Design Score but also graded independently as a headline metric.

### Regression Output

When previous `design-baseline.json` exists or `--regression` flag is used:
- Previous baseline = the newest readable `design-baseline*.json` under `$GSTACK_STATE_ROOT/projects/$SLUG/designs/design-audit-*/` older than this run; unreadable → "previous baseline unreadable (first scan)"
     1	import { useEffect, useRef, useState } from 'react'
     2	import { hhmm, sgn, type Fill } from '@/lib/backed'
     3	
     4	// Stepped realized PnL from HyperCore fills (no fill under the line), the backer's line, and live equity at the right edge.
     5	export function Equity({ readAt, fills, eq, floor, loaded, failed, bounties }: { readAt: number | null; fills: Fill[]; eq: number; floor: number; loaded: boolean; failed: boolean; bounties: number }) {
     6	  const ref = useRef<HTMLDivElement>(null)
     7	  const [W, setW] = useState(800)
     8	  useEffect(() => {
     9	    const el = ref.current; if (!el) return
    10	    const ro = new ResizeObserver(() => setW(el.clientWidth)); ro.observe(el); return () => ro.disconnect()
    11	  }, [])
    12	  if (!loaded) return <div ref={ref} className="chart-state">Reading fills from HyperCore&hellip;</div>
    13	  if (!fills.length && failed) return <div ref={ref} className="chart-state">The HyperCore info API did not answer, so the fills are unknown, not empty. Retrying every 60 s.</div>
    14	  if (!fills.length) return <div ref={ref} className="chart-state">No fills on this vault yet. The line appears after the first trade.</div>
    15	  const H = 240, L = 48, R = W < 560 ? 96 : 120, T = 16, B = 26
    16	  let cum = 0
    17	  const pts = fills.map((f) => { cum += Number(f.closedPnl) - Number(f.fee); return { t: f.time, v: cum } })
    18	  const t0 = pts[0].t - 30000, t1 = pts[pts.length - 1].t + 30000
    19	  pts.unshift({ t: t0, v: 0 }); pts.push({ t: t1, v: cum })
    20	  const vs = pts.map((p) => p.v).concat([floor, 0, eq]); const lo = Math.min(...vs) - 0.3, hi = Math.max(...vs) + 0.3
    21	  const x = (t: number) => L + ((t - t0) / (t1 - t0)) * (W - L - R)
    22	  const y = (v: number) => T + (1 - (v - lo) / (hi - lo)) * (H - T - B)
    23	  const d = pts.map((p, i) => (i ? `H${x(p.t).toFixed(1)}V${y(p.v).toFixed(1)}` : `M${x(p.t).toFixed(1)},${y(p.v).toFixed(1)}`)).join('')
    24	  const nx = W - 8 - R / 2
    25	  const gap = eq - cum
    26	  return (
    27	    <div ref={ref}>
    28	      <svg className="chart" width={W} height={H} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Realized PnL over ${fills.length} fills, ending ${sgn(cum)} USDC; live equity ${sgn(eq)}`}>
    29	        {[lo, (lo + hi) / 2, hi].map((v) => (
    30	          <g key={v} className="grid"><line x1={L} x2={W - 8} y1={y(v)} y2={y(v)} /><text x={L - 8} y={y(v) + 4} textAnchor="end">{v.toFixed(2)}</text></g>
    31	        ))}
    32	        <line className="zero" x1={L} x2={W - 8} y1={y(0)} y2={y(0)} />
    33	        <text className="lbl" x={L + 6} y={y(0) - 6}>capital</text>
    34	        <line className="floor" x1={L} x2={W - 8} y1={y(floor)} y2={y(floor)} />
    35	        <text className="lbl lbl-alarm" x={L + 6} y={y(floor) - 6}>backer&rsquo;s line {sgn(floor)}</text>
    36	        <path className="step" d={d} />
    37	        <line className="zero" x1={x(t1)} x2={x(t1)} y1={T} y2={H - B} strokeDasharray="2 4" />
    38	        <rect className="now" x={nx - 3} y={y(eq) - 3} width={6} height={6} />
    39	        <text className="lbl lbl-ink" x={nx} y={y(eq) - 10} textAnchor="middle">{readAt ? `read ${hhmm(readAt).replace(' IST', '')}` : 'last read'} {sgn(eq)}</text>
    40	        <text className="lbl" x={L} y={H - 6}>{hhmm(t0)}</text>
    41	        <text className="lbl" x={x(t1)} y={H - 6} textAnchor="end">{hhmm(t1)}</text>
    42	      </svg>
    43	      <p className="note">
    44	        {fills.length} HyperCore fills, realized PnL after fees.{failed && ' The latest refresh failed; showing the last fills received.'}
    45	        {Math.abs(gap) > 0.05 && ` Live equity is ${Math.abs(gap).toFixed(2)} USDC under realized PnL: ${bounties} flatten bount${bounties === 1 ? 'y was' : 'ies were'} paid out of the vault, plus funding.`}
    46	      </p>
    47	    </div>
    48	  )
    49	}
     1	import type { Evidence } from '@/lib/backed'
     2	import { Tx } from './Tx'
     3	
     4	type Inc = { title: string; body: string; when: string; tx: string | null; breach: boolean; ms?: number }
     5	
     6	// GitHub-status style incident log built from the live testnet evidence file.
     7	export function buildIncidents(ev: Evidence): Inc[] {
     8	  const out: Inc[] = []
     9	  for (const g of ev.groups) {
    10	    if (!/^V3/.test(g.title)) continue
    11	    for (const i of g.items) {
    12	      const ms = Number((i.label.match(/fill (\d+) ms/) || [])[1])
    13	      if (ms) {
    14	        const who = /keeper/.test(i.label) ? 'the public keeper' : 'a script standing in for any caller'
    15	        const slow = ms > 10000 ? ' The tx waited about 51 s for a block: this run measures block inclusion, not the contract.' : ''
    16	        out.push({ title: `Loss line crossed. Flat in ${(ms / 1000).toFixed(2)} s`, body: `flatten() called by ${who}.${slow}`, when: 'Oct 10, 2026', tx: i.tx, breach: true, ms })
    17	      } else if (/revert|rejected/i.test(i.label)) {
    18	        const what = i.label.replace(/^rejected:\s*/i, '').replace(/,?\s*reverted.*$/i, '').replace(/\s*\(equity floor\)/, '')
    19	        if (out.some((o) => o.title.endsWith(what))) continue
    20	        out.push({ title: 'Refused: ' + what, body: '', when: 'Oct 10, 2026', tx: i.tx, breach: false })
    21	      }
    22	    }
    23	  }
    24	  return out
    25	}
    26	
    27	export function Incidents({ ev }: { ev: Evidence }) {
    28	  const list = buildIncidents(ev)
    29	  const breaches = list.filter((x) => x.breach), refused = list.filter((x) => !x.breach)
    30	  const ms = breaches.map((x) => x.ms!).sort((a, b) => a - b), med = ms[Math.floor(ms.length / 2)]
    31	  const control = ev.groups.find((g) => /^Control/.test(g.title))
    32	  return (
    33	    <div className="incidents">
    34	      <aside className="inc-sum" aria-label="Summary">
    35	        <dl>
    36	          <div><dt>Live breach runs recorded</dt><dd>{breaches.length}, each ending in a flatten fill</dd></div>
    37	          <div><dt>Median, breach to fill</dt><dd>{(med / 1000).toFixed(2)} s</dd></div>
    38	          <div><dt>Orders refused on chain</dt><dd>{refused.length}</dd></div>
    39	        </dl>
    40	        <p>All runs on Oct 10, 2026 against a vault funded with 20 test USDC. Times run from the breach to the HyperCore fill. Refused orders reverted in the contract, so nothing reached HyperCore.</p>
    41	        {control && <p>Control: the same breach on an account run by a trusted API wallet was still open after 60 s in both runs, because nobody else may close it.</p>}
    42	      </aside>
    43	      <div>
    44	        <h3 className="month">October 2026</h3>
    45	        <ol className="rail">
    46	          {breaches.concat(refused).map((x, i) => (
    47	            <li key={i} className={x.breach ? 'inc inc-breach' : 'inc'}>
    48	              <p className="inc-title">{x.title}</p>
    49	              <p className="inc-when">{x.body && <span className="inc-body">{x.body} </span>}{x.when} · <Tx hash={x.tx} /></p>
    50	            </li>
    51	          ))}
    52	        </ol>
    53	      </div>
    54	    </div>
    55	  )
    56	}
     1	import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table'
     2	import { MK, SZD, sgn, usd, type Vault } from '@/lib/backed'
     3	import { Tx } from './Tx'
     4	
     5	// Stripe-style parameter sheet: each rule is a parameter, its live value, what happens, and the proof it bites.
     6	export function RulesSheet({ s, proof }: { s: Vault; proof: Record<string, string | null | undefined> }) {
     7	  const open = s.pos.filter((p) => p.szi).map((p) => `${MK[p.m]} ${(p.szi / 10 ** SZD[p.m]).toFixed(SZD[p.m])}`).join(', ')
     8	  const rows: [string, string, string, string | null | undefined, string?][] = [
     9	    ['allowed_markets', s.markets.map((m) => MK[m] ?? m).join(', '), 'Orders on any other market revert.', proof.market],
    10	    ['max_leverage', `${s.maxLev}x of ${usd(s.cap)} USDC`, 'All positions together, at the oracle price, after the fill. Stacked orders count.', proof.stacked],
    11	    ['loss_line', `${sgn(s.floor / 1e6)} USDC`, 'Account value minus capital. Realized losses count, so closing and reopening does not reset it.', proof.floor],
    12	    ['daily_loss', s.dl ? `${usd(s.dl)} USDC` : 'off', "Measured from the day's first equity reading.", undefined],
    13	    ['flatten', `anyone, ${usd(s.bo)} USDC bounty`, 'Below the line, any address can close every position. Retried until flat.', proof.flatten, 'flatten fill'],
    14	    ['after_breach', 'frozen', 'New orders revert until the backer rearms, and rearm reverts while still below the line.', proof.frozen],
    15	    ['settle', `trader keeps ${s.sh / 100}% of profit`, 'Backer gets principal first. No operator signs anything.', undefined],
    16	  ]
    17	  return (
    18	    <Table className="sheet">
    19	      <TableHeader>
    20	        <TableRow>
    21	          <TableHead className="w-[11rem]">Parameter</TableHead>
    22	          <TableHead className="w-[12rem]">Value now</TableHead>
    23	          <TableHead>What the contract does</TableHead>
    24	          <TableHead className="w-[7rem] text-right">Proof</TableHead>
    25	        </TableRow>
    26	      </TableHeader>
    27	      <TableBody>
    28	        {rows.map(([k, v, d, tx, kind]) => (
    29	          <TableRow key={k}>
    30	            <TableCell><code className="param">{k}</code></TableCell>
    31	            <TableCell className="num">{v}</TableCell>
    32	            <TableCell className="text-dim whitespace-normal">{d}</TableCell>
    33	            <TableCell className="text-right">{tx ? <Tx hash={tx} label={kind ?? 'rejected order'} /> : <a className="tx" href="https://github.com/kamalbuilds/backed-hl/blob/main/contracts/test/BackedVaultV3.t.sol" target="_blank" rel="noopener">forge test</a>}</TableCell>
    34	          </TableRow>
    35	        ))}
    36	        <TableRow>
    37	          <TableCell><code className="param">positions</code></TableCell>
    38	          <TableCell className="num">{open || 'flat'}</TableCell>
    39	          <TableCell className="text-dim whitespace-normal">Read from the HyperCore position precompile.</TableCell>
    40	          <TableCell />
    41	        </TableRow>
    42	      </TableBody>
    43	    </Table>
    44	  )
    45	}
     1	// Signature: the backer's loss line on a ruler in USDC, with live equity against it.
     2	import { sgn } from '@/lib/backed'
     3	
     4	export function LossRuler({ eq, floor, flash }: { eq: number; floor: number; flash: boolean }) {
     5	  const lo = Math.floor(Math.min(floor, eq) - 1), hi = Math.ceil(Math.max(1, eq + 0.5))
     6	  const pct = (x: number) => ((x - lo) / (hi - lo)) * 100
     7	  const step = hi - lo > 6 ? 1 : 0.5
     8	  const ticks: number[] = []
     9	  for (let v = lo; v <= hi + 1e-9; v += step) ticks.push(Math.round(v * 100) / 100)
    10	  const below = eq < floor
    11	  return (
    12	    <figure
    13	      className={`ruler${flash ? ' ruler-flash' : ''}${below ? ' ruler-below' : ''}`}
    14	      role="meter" aria-label="Equity against the backer's loss line, USDC"
    15	      aria-valuemin={lo} aria-valuemax={hi} aria-valuenow={Number(eq.toFixed(2))}
    16	    >
    17	      <div className="ruler-track">
    18	        <div className="ruler-dead" style={{ width: `${pct(floor)}%` }} />
    19	        <div className="ruler-line" style={{ left: `${pct(floor)}%` }}>
    20	          <span className="ruler-line-label">backer&rsquo;s line {sgn(floor)}</span>
    21	        </div>
    22	        <div className="ruler-zero" style={{ left: `${pct(0)}%` }} />
    23	        <div className="ruler-eq-slide" style={{ transform: `translateX(${pct(eq)}%)` }}>
    24	          <div className="ruler-eq"><span className="ruler-eq-label">equity {sgn(eq)}</span></div>
    25	        </div>
    26	        <div className="ruler-flash-layer" />
    27	      </div>
    28	      <div className="ruler-ticks" aria-hidden="true">
    29	        {ticks.map((t) => (
    30	          <span key={t} style={{ left: `${pct(t)}%` }} className={Number.isInteger(t) ? 'major' : ''}>
    31	            {Number.isInteger(t) ? (t === 0 ? '0' : sgn(t).replace('.00', '')) : ''}
    32	          </span>
    33	        ))}
    34	      </div>
    35	      <figcaption className="sr-only">Capital is 0. Left of the red line the contract lets anyone flatten the vault.</figcaption>
    36	    </figure>
    37	  )
    38	}

